{
    // The drift check: npm run check:types compiles check.ts against the definitions in src/, and fails if they don't
    // fit together or no longer allow what a component does with them.
    "compilerOptions": {
        "strict": true,
        "noEmit": true,
        "skipLibCheck": false,
        "noUncheckedSideEffectImports": true,
        "target": "es2022",
        "module": "esnext",
        "moduleResolution": "bundler",
        "lib": ["es2022", "dom", "dom.iterable"],
        "types": [],
        // Import burrowkit by name, as a component that installed it does.
        "paths": {
            "burrowkit/*": ["../src/*"]
        }
    },
    "files": ["check.ts"]
}